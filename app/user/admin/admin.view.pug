extends /resources/angle/pug/edit

block title
  span(
    translate="admin.form.title.EDIT",
    translate-value-username="{{ vm.edit.input.username }}"
  )

block form
  admin-form(form="vm.edit")

block append left-side
  admin-notifications(
    ng-if="vm.edit.input.id"
    admin-id="vm.edit.input.id"
  )

block append right-side
  admin-buttons(admin="vm.edit.input")
